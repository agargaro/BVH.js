{
  "name": "bvh.js",
  "version": "0.0.13",
  "description": "Dynamic BVH implementation based on Erin Catto's paper.",
  "author": "Andrea Gargaro <devgargaro@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "module": "./build/index.js",
  "types": "./build/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/index.d.ts",
      "import": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "LICENSE",
    "README.md"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "homepage": "https://github.com/agargaro/bvh.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agargaro/bvh.js.git"
  },
  "keywords": [
    "bvh",
    "raycast",
    "frustum-culling",
    "bounds-hierarchy",
    "performance",
    "three",
    "intersection",
    "acceleration",
    "spatial-indexing"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx --tsconfig benchmarks/tsconfig.tsx.json benchmarks/index.ts",
    "bench:validate": "tsx --tsconfig benchmarks/tsconfig.tsx.json benchmarks/index.ts --validate",
    "bench:compare": "tsx benchmarks/compare.ts",
    "check": "npm run build && npm run lint && npm run typecheck && npm run test:coverage && npm run bench:validate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "tinybench": "6.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
